{
  "info": {
    "name": "Toss Payments API QA",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{secretKey}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// 주문번호 qa-{runId}-{케이스ID}에 쓰는 실행 ID",
          "if (!pm.variables.get(\"runId\")) {",
          "  pm.variables.set(\"runId\", Date.now().toString(36) + Math.random().toString(36).slice(2, 6));",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// 새로 만든 결제를 기록해 두고 99 정리 폴더에서 취소한다.",
          "if (pm.request.method === \"POST\" && pm.response.code === 200) {",
          "  let res = null;",
          "  try { res = pm.response.json(); } catch (e) {}",
          "  if (res && res.paymentKey) {",
          "    const keys = JSON.parse(pm.variables.get(\"createdPaymentKeys\") || \"[]\");",
          "    if (!keys.includes(res.paymentKey)) {",
          "      keys.push(res.paymentKey);",
          "      pm.variables.set(\"createdPaymentKeys\", JSON.stringify(keys));",
          "    }",
          "  }",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 인증, 조회 오류",
      "item": [
        {
          "name": "AUTH-01 잘못된 시크릿 키",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"AUTH-01 HTTP 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"AUTH-01 에러 코드 UNAUTHORIZED_KEY\", () => pm.expect(res.code).to.eql(\"UNAUTHORIZED_KEY\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/payments/orders/qa-{{runId}}-AUTH-01",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "test_sk_invalid_key_for_qa_00000000",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "AUTH-02 없는 결제 조회",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"AUTH-02 HTTP 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"AUTH-02 에러 코드 NOT_FOUND_PAYMENT\", () => pm.expect(res.code).to.eql(\"NOT_FOUND_PAYMENT\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/payments/qa-not-exist-{{runId}}"
          }
        }
      ]
    },
    {
      "name": "02 결제",
      "item": [
        {
          "name": "PAY-01 키인 결제",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"PAY-01 HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"PAY-01 상태 DONE\", () => pm.expect(res.status).to.eql(\"DONE\"));",
                  "pm.test(\"PAY-01 총액, 잔액 10,000\", () => {",
                  "  pm.expect(res.totalAmount).to.eql(10000);",
                  "  pm.expect(res.balanceAmount).to.eql(10000);",
                  "});",
                  "pm.test(\"PAY-01 주문번호가 요청 값과 같음\", () =>",
                  "  pm.expect(res.orderId).to.eql(\"qa-\" + pm.variables.get(\"runId\") + \"-PAY-01\"));",
                  "pm.variables.set(\"payKey\", res.paymentKey);",
                  "pm.variables.set(\"payOrderId\", res.orderId);",
                  "pm.variables.set(\"payMethod\", res.method);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/payments/key-in",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 10000,\n  \"orderId\": \"qa-{{runId}}-PAY-01\",\n  \"orderName\": \"QA 자동화 키인 결제\",\n  \"cardNumber\": \"{{testCardNumber}}\",\n  \"cardExpirationYear\": \"{{cardExpirationYear}}\",\n  \"cardExpirationMonth\": \"{{cardExpirationMonth}}\",\n  \"customerIdentityNumber\": \"{{customerIdentityNumber}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "PAY-02 paymentKey로 조회",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"PAY-02 HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"PAY-02 PAY-01 결제와 값이 일치\", () => {",
                  "  pm.expect(res.paymentKey).to.eql(pm.variables.get(\"payKey\"));",
                  "  pm.expect(res.orderId).to.eql(pm.variables.get(\"payOrderId\"));",
                  "  pm.expect(res.method).to.eql(pm.variables.get(\"payMethod\"));",
                  "  pm.expect(res.status).to.eql(\"DONE\");",
                  "  pm.expect(res.totalAmount).to.eql(10000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/payments/{{payKey}}"
          }
        },
        {
          "name": "PAY-03 orderId로 조회",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"PAY-03 HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"PAY-03 같은 paymentKey 조회\", () =>",
                  "  pm.expect(res.paymentKey).to.eql(pm.variables.get(\"payKey\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/payments/orders/{{payOrderId}}"
          }
        },
        {
          "name": "PAY-04 같은 주문번호로 다시 결제",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"PAY-04 HTTP 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"PAY-04 에러 코드 DUPLICATED_ORDER_ID\", () => pm.expect(res.code).to.eql(\"DUPLICATED_ORDER_ID\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/payments/key-in",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 10000,\n  \"orderId\": \"qa-{{runId}}-PAY-01\",\n  \"orderName\": \"QA 자동화 키인 결제\",\n  \"cardNumber\": \"{{testCardNumber}}\",\n  \"cardExpirationYear\": \"{{cardExpirationYear}}\",\n  \"cardExpirationMonth\": \"{{cardExpirationMonth}}\",\n  \"customerIdentityNumber\": \"{{customerIdentityNumber}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
