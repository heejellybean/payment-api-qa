    {
      "name": "99 정리",
      "item": [
        {
          "name": "CLEAN-01 정리 대상 조회",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get(\"cleanQueue\")) {",
                  "  pm.variables.set(\"cleanQueue\", pm.variables.get(\"createdPaymentKeys\") || \"[]\");",
                  "}",
                  "const queue = JSON.parse(pm.variables.get(\"cleanQueue\"));",
                  "pm.variables.set(\"cleanKey\", queue.length ? queue[0] : \"none\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const queue = JSON.parse(pm.variables.get(\"cleanQueue\"));",
                  "if (queue.length === 0) {",
                  "  pm.test(\"CLEAN 이번 실행에서 만든 결제 없음\", () => pm.expect(queue).to.be.empty);",
                  "  pm.execution.setNextRequest(null);",
                  "} else {",
                  "  const res = pm.response.json();",
                  "  pm.test(\"CLEAN 정리 대상 조회 성공\", () => pm.response.to.have.status(200));",
                  "  const cancelable = [\"DONE\", \"PARTIAL_CANCELED\", \"WAITING_FOR_DEPOSIT\"].includes(res.status)",
                  "    && res.balanceAmount > 0;",
                  "  if (cancelable) {",
                  "    pm.execution.setNextRequest(\"CLEAN-02 남은 금액 전액취소\");",
                  "  } else {",
                  "    queue.shift();",
                  "    pm.variables.set(\"cleanQueue\", JSON.stringify(queue));",
                  "    pm.execution.setNextRequest(queue.length ? \"CLEAN-01 정리 대상 조회\" : null);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v1/payments/{{cleanKey}}"
          }
        },
        {
          "name": "CLEAN-02 남은 금액 전액취소",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"CLEAN 남은 금액 취소 후 잔액 0\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(res.balanceAmount).to.eql(0);",
                  "});",
                  "const queue = JSON.parse(pm.variables.get(\"cleanQueue\"));",
                  "queue.shift();",
                  "pm.variables.set(\"cleanQueue\", JSON.stringify(queue));",
                  "if (queue.length) pm.execution.setNextRequest(\"CLEAN-01 정리 대상 조회\");"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v1/payments/{{cleanKey}}/cancel",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cancelReason\": \"QA 자동화 실행 후 정리\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
