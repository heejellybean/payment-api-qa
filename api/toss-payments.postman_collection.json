    {
      "name": "04 가상계좌",
      "item": [
        {
          "name": "VA-01 가상계좌 발급",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"VA-01 HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"VA-01 상태 WAITING_FOR_DEPOSIT\", () => pm.expect(res.status).to.eql(\"WAITING_FOR_DEPOSIT\"));",
                  "pm.test(\"VA-01 계좌번호, 은행코드, 입금기한 존재\", () => {",
                  "  pm.expect(res.virtualAccount.accountNumber).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(res.virtualAccount.bankCode).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(res.virtualAccount.dueDate).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "pm.variables.set(\"vaKey\", res.paymentKey);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
