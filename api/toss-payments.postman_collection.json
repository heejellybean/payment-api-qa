                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"CAN-01 HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"CAN-01 상태 PARTIAL_CANCELED\", () => pm.expect(res.status).to.eql(\"PARTIAL_CANCELED\"));",
                  "pm.test(\"CAN-01 잔액 7,000\", () => pm.expect(res.balanceAmount).to.eql(7000));",
                  "pm.test(\"CAN-01 취소 내역 1건, 금액 3,000\", () => {",
                  "  pm.expect(res.cancels).to.have.lengthOf(1);",
                  "  pm.expect(res.cancels[0].cancelAmount).to.eql(3000);",
